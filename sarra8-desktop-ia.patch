+</style>
+</head>
+<body data-mode="avatar">
+
+<!-- ==================== Mode réglages : onglets + 2 panneaux ==================== -->
+<div id="tabs" hidden>
+  <span class="brand">SARRA</span>
+  <button class="tab" id="tab-native" aria-selected="true" type="button">Identité, IA &amp; directives</button>
+  <button class="tab" id="tab-app" aria-selected="false" type="button">Panneau Sarra Studio</button>
+  <span class="spacer"></span>
+  <button class="win-btn" id="btn-close" title="Masquer les réglages (Ctrl+Shift+K)" type="button">✕</button>
+</div>
+
+<div id="grip" hidden title="Redimensionner"></div>
+
+<!-- Mode avatar : iframe de l'app + écran de démarrage -->
+<iframe id="app-frame" title="Avatar Sarra" allow="microphone; autoplay; camera"></iframe>
+
+<!-- Mode réglages : panneau natif (état, IA, directives, onboarding) -->
+<iframe id="panel-native" hidden title="Réglages Sarra" allow="microphone"></iframe>
+
+<div id="startup" data-state="loading">
+  <div class="box">
+    <div class="ring" aria-hidden="true"></div>
+    <div class="bar" aria-hidden="true"><i></i></div>
+    <div class="label" id="startup-label">Chargement de l'avatar…</div>
+    <div class="detail" id="startup-detail"></div>
+    <div class="actions">
+      <button id="startup-settings" type="button" hidden>Ouvrir les réglages</button>
+      <button id="startup-retry" type="button" hidden>Réessayer</button>
+    </div>
+  </div>
+</div>
+
+<script>
+'use strict';
+
+/* ==========================================================================
+ * Paramètres fournis par main.js
+ *   ?mode=avatar|settings & app=<url absolue de l'app>
+ * ========================================================================== */
+const params = new URLSearchParams(location.search);
+const MODE = params.get('mode') === 'settings' ? 'settings' : 'avatar';
+const APP_URL = params.get('app') || '';
+
+const bridge = window.sarraDesktop || window.sarra8 || {};
+const panelApi = window.sarra8 || window.sarraDesktop || {};
+
+document.body.dataset.mode = MODE;
+
+const appFrame = document.getElementById('app-frame');
+const nativeFrame = document.getElementById('panel-native');
+const startup = document.getElementById('startup');
+const startupLabel = document.getElementById('startup-label');
+const startupDetail = document.getElementById('startup-detail');
+const startupRetry = document.getElementById('startup-retry');
+const startupSettings = document.getElementById('startup-settings');
+const tabs = document.getElementById('tabs');
+const grip = document.getElementById('grip');
+
+/* ==========================================================================
+ * 1. URL de l'iframe
+ * ========================================================================== */
+function frameUrl(shell) {
+  if (!APP_URL) return 'about:blank';
+  const url = new URL(APP_URL);
+  url.searchParams.set('shell', shell);
+  return url.toString();
+}
+
+/* ==========================================================================
+ * 2. Mode avatar : iframe plein cadre + démarrage
+ * ========================================================================== */
+function initAvatarMode() {
+  if (!APP_URL) {
+    setStartup('error', "Application web introuvable. Vérifiez que le fichier « Sarra — avatar VRM & lipsync avancé.html » est à la racine.");
+    return;
+  }
+
+  appFrame.src = frameUrl('avatar');
+
+  // L'app prévient la coque de l'avancement du chargement du VRM.
+  window.addEventListener('message', (event) => {
+    if (event.origin !== location.origin) return;
+    const data = event.data;
+    if (!data || data.type !== 'sarra-startup') return;
+    if (data.state === 'complete') setStartup('complete');
+    else if (data.state === 'error') setStartup('error', data.detail || 'Le modèle VRM n’a pas pu être chargé.');
+    else setStartup('loading', data.detail || 'Chargement de l’avatar…');
+  });
+
+  // Filet de sécurité : si l'app n'annonce rien, on masque après 14 s.
+  const guard = setTimeout(() => setStartup('complete'), 14000);
+
+  initEdgeResize();
+
+  appFrame.addEventListener('load', () => {
+    clearTimeout(guard);
+    attachFrameListeners();
+    // Le VRM est chargé de manière asynchrone : on laisse l'écran visible
+    // jusqu'au message 'complete', mais on plafonne.
+    setTimeout(() => {
+      if (startup.dataset.state === 'loading') setStartup('complete');
+    }, 6000);
+  });
+
+  startupRetry.addEventListener('click', () => {
+    setStartup('loading');
+    appFrame.src = frameUrl('avatar');
+  });
+
+  startupSettings.addEventListener('click', () => {
+    bridge.toggleSettings && bridge.toggleSettings(true);
+  });
+
+  // Modèle VRM : la coque pousse sarra7.vrm, ou signale son absence.
+  if (bridge.on) {
+    bridge.on('vrm:missing', (payload) => {
+      setStartup('missing', (payload && payload.message) || 'Aucun modèle VRM par défaut.');
+    });
+    bridge.on('vrm:status', (payload) => {
+      if (payload && payload.ok) setStartup('complete');
+      else if (payload) setStartup('missing', payload.error || 'Le modèle VRM n’a pas pu être chargé.');
+    });
+  }
+
+  // Interrupteur de secours : Ctrl+Shift+L verrouille/déverrouille l'interaction.
+  document.addEventListener('keydown', (event) => {
+    if (event.ctrlKey && event.shiftKey && event.key.toLowerCase() === 'l') {
+      event.preventDefault();
+      bridge.setInteractiveLock && bridge.setInteractiveLock(true);
+    }
+  });
+}
+
+function setStartup(state, detail = '') {
+  startup.dataset.state = state;
+  const labels = {
+    complete: '',
+    error: 'Chargement impossible',
+    missing: 'Avatar 3D non chargé',
+    loading: 'Chargement de l’avatar…'
+  };
+  startupLabel.textContent = labels[state] || labels.loading;
+  startupDetail.textContent = detail;
+  startupRetry.hidden = state !== 'error' && state !== 'missing';
+  startupSettings.hidden = state !== 'missing' && state !== 'error';
+  if (state === 'complete') {
+    startup.setAttribute('hidden', '');
+  } else {
+    startup.removeAttribute('hidden');
+  }
+}
+
+/* ==========================================================================
+ * 3. Survol de l'avatar -> click-through (tâche 1 & 2)
+ *
+ * L'iframe est de même origine : on peut donc écouter directement les
+ * événements de son document (mouseenter/mouseleave, molette, clavier).
+ * Main conserve en parallèle un test de position du curseur (filet de
+ * sécurité multi-plateforme, voir main.js).
+ * ========================================================================== */
+let interactive = false;
+
+function enterInteractive() {
+  if (interactive) return;
+  interactive = true;
+  bridge.setIgnoreMouseEvents && bridge.setIgnoreMouseEvents(false);
+}
+
+function leaveInteractive() {
+  if (!interactive) return;
+  interactive = false;
+  bridge.setIgnoreMouseEvents && bridge.setIgnoreMouseEvents(true);
+}
+
+function attachFrameListeners() {
+  let doc = null;
+  try {
+    doc = appFrame.contentDocument;
+  } catch (_) {
+    return; // cross-origin : on laisse le test de position du main décider
+  }
+  if (!doc || doc.__sarraShellHooked) return;
+  doc.__sarraShellHooked = true;
+
+  const root = doc.documentElement;
+
+  root.addEventListener('mouseenter', enterInteractive, true);
+  root.addEventListener('mouseleave', leaveInteractive, true);
+  doc.addEventListener('mouseleave', leaveInteractive, true);
+  window.addEventListener('mouseleave', leaveInteractive, true);
+
+  // Molette au-dessus de l'avatar -> redimensionnement de la fenêtre
+  // (tâche 2 : « redimensionnable via la molette »).
+  let wheelTimer = null;
+  let wheelDelta = 0;
+  root.addEventListener('wheel', (event) => {
+    event.preventDefault();
+    wheelDelta += event.deltaY;
+    if (wheelTimer) return;
+    wheelTimer = setTimeout(() => {
+      const deltaY = wheelDelta;
+      wheelDelta = 0;
+      wheelTimer = null;
+      if (Math.abs(deltaY) < 1) return;
+      bridge.resizeAvatar && bridge.resizeAvatar({ deltaY });
+    }, 60);
+  }, { passive: false });
+
+  // Perte de focus : on rend la souris transparente pour ne pas bloquer
+  // les clics vers les fenêtres situées dessous.
+  window.addEventListener('blur', () => { if (!interactive) return; leaveInteractive(); });
+  doc.addEventListener('visibilitychange', () => { if (doc.hidden) leaveInteractive(); });
+}
+
+/* ==========================================================================
+ * 3 bis. Redimensionnement par les bords (fenêtre avatar frameless)
+ *
+ * Les poignées sont des surcouches au-dessus de l'iframe : elles captent le
+ * pointerdown sur 6 px de bord, le reste de la fenêtre continue de recevoir
+ * les clics destinés à l'avatar.
+ * ========================================================================== */
+const EDGES = ['n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'];
+
+function initEdgeResize() {
+  const handles = EDGES.map((dir) => {
+    const el = document.createElement('div');
+    el.className = 'edge';
+    el.dataset.dir = dir;
+    document.body.appendChild(el);
+    return el;
+  });
+
+  let resize = null;
+
+  for (const handle of handles) {
+    handle.addEventListener('pointerdown', (event) => {
+      if (event.button !== 0) return;
+      event.preventDefault();
+      event.stopPropagation();
+      resize = {
+        dir: handle.dataset.dir,
+        sx: event.screenX,
+        sy: event.screenY,
+        w: window.innerWidth,
+        h: window.innerHeight,
+        x: window.screenX,
+        y: window.screenY
+      };
+      enterInteractive();
+      try { handle.setPointerCapture(event.pointerId); } catch (_) { /* ignore */ }
+    });
+  }
+
+  window.addEventListener('pointermove', (event) => {
+    if (!resize) return;
+    const { dir, sx, sy, w, h, x, y } = resize;
+    const dx = event.screenX - sx;
+    const dy = event.screenY - sy;
+
+    const aspect = h / w;
+    let width = w;
+    if (dir.includes('e')) width = w + dx;
+    if (dir.includes('w')) width = w - dx;
+    if (dir === 'n' || dir === 's') width = (h + (dir === 's' ? dy : -dy)) / aspect;
+
+    width = Math.max(160, Math.min(900, width));
+    const height = Math.round(width * aspect);
+
+    // Ancrage : le bord opposé reste fixe.
+    const nextX = dir.includes('w') ? x + (w - Math.round(width)) : x;
+    const nextY = dir.includes('n') ? y + (h - height) : y;
+
+    bridge.resizeAvatar && bridge.resizeAvatar({ w: Math.round(width), aspect, x: nextX, y: nextY });
+  });
+
+  const stop = () => { resize = null; };
+  window.addEventListener('pointerup', stop);
+  window.addEventListener('pointercancel', stop);
+}
+
+/* ==========================================================================
+ * 4. Mode réglages : onglets + panneaux
+ * ========================================================================== */
+let activeTab = 'native';
+
+function initSettingsMode() {
+  tabs.hidden = false;
+  grip.hidden = false;
+  startup.setAttribute('hidden', '');
+
+  nativeFrame.src = `${location.origin}/desktop/settings-panel.html`;
+  appFrame.src = frameUrl('settings');
+
+  selectTab('native');
+
+  document.getElementById('tab-native').addEventListener('click', () => selectTab('native'));
+  document.getElementById('tab-app').addEventListener('click', () => selectTab('app'));
+  document.getElementById('btn-close').addEventListener('click', () => {
+    panelApi.closeSettings ? panelApi.closeSettings() : window.close();
+  });
+
+  // Le panneau natif peut demander l'onglet « Sarra Studio ».
+  window.addEventListener('message', (event) => {
+    if (event.origin !== location.origin) return;
+    const data = event.data;
+    if (!data) return;
+    if (data.type === 'sarra-switch-tab' && (data.tab === 'app' || data.tab === 'native')) selectTab(data.tab);
+    if (data.type === 'sarra-close-settings') panelApi.closeSettings && panelApi.closeSettings();
+  });
+
+  // Relais de l'onboarding : le main envoie `trigger-onboarding` au shell.
+  if (panelApi.on) {
+    panelApi.on('trigger-onboarding', (payload) => {
+      try {
+        nativeFrame.contentWindow.postMessage({ type: 'sarra-onboarding', payload }, location.origin);
+      } catch (_) { /* ignore */ }
+      selectTab('native');
+    });
+  }
+
+  bindWindowChrome();
+}
+
+function selectTab(tab) {
+  activeTab = tab;
+  document.getElementById('tab-native').setAttribute('aria-selected', String(tab === 'native'));
+  document.getElementById('tab-app').setAttribute('aria-selected', String(tab === 'app'));
+  nativeFrame.hidden = tab !== 'native';
+  appFrame.hidden = tab !== 'app';
+  // Les deux iframes restent chargées (l'avatar doit continuer de vivre dans
+  // la fenêtre avatar ; ici l'onglet Studio n'est qu'un panneau de réglages).
+}
+
+/* ==========================================================================
+ * 5. Chromes de fenêtre (déplacement / taille) — frameless
+ * ========================================================================== */
+function bindWindowChrome() {
+  // Déplacement par la barre d'onglets
+  let drag = null;
+  tabs.addEventListener('pointerdown', (event) => {
+    if (event.button !== 0) return;
+    if (event.target.closest('button')) return;
+    drag = { sx: event.screenX, sy: event.screenY };
+    try { tabs.setPointerCapture(event.pointerId); } catch (_) {}
+    panelApi.dragStart && panelApi.dragStart({ x: event.screenX, y: event.screenY });
+  });
+  window.addEventListener('pointermove', (event) => {
+    if (!drag) return;
+    panelApi.dragMove && panelApi.dragMove({ x: event.screenX, y: event.screenY });
+  });
+  const endDrag = () => {
+    if (!drag) return;
+    drag = null;
+    panelApi.dragEnd && panelApi.dragEnd();
+  };
+  window.addEventListener('pointerup', endDrag);
+  window.addEventListener('pointercancel', endDrag);
+
+  // Redimensionnement par la poignée
+  let rs = null;
+  grip.addEventListener('pointerdown', (event) => {
+    event.preventDefault();
+    rs = { sx: event.screenX, sy: event.screenY, w: innerWidth, h: innerHeight };
+    try { grip.setPointerCapture(event.pointerId); } catch (_) {}
+  });
+  window.addEventListener('pointermove', (event) => {
+    if (!rs) return;
+    panelApi.resizeSettings && panelApi.resizeSettings({
+      w: rs.w + (event.screenX - rs.sx),
+      h: rs.h + (event.screenY - rs.sy)
+    });
+  });
+  window.addEventListener('pointerup', () => { rs = null; });
+  window.addEventListener('pointercancel', () => { rs = null; });
+
+  // Échap ferme les réglages (comme le panneau d'origine)
+  window.addEventListener('keydown', (event) => {
+    if (event.key === 'Escape') panelApi.closeSettings && panelApi.closeSettings();
+  });
+}
+
+/* ==========================================================================
+ * 6. Démarrage
+ * ========================================================================== */
+if (MODE === 'settings') initSettingsMode();
+else initAvatarMode();
+</script>
+</body>
+</html>
