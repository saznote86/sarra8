+  assert.equal(contents[contents.length - 1].parts[0].text, 'nouvelle question');
+  for (let i = 1; i < contents.length; i += 1) {
+    assert.notEqual(contents[i].role, contents[i - 1].role, 'les rôles doivent alterner');
