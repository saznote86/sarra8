+    alwaysOnTop: true,            // l'overlay reste au-dessus des fenêtres ordinaires
+    skipTaskbar: false,
+    title: 'Sarra — Réglages',
+    webPreferences: {
+      preload: path.join(DESKTOP, 'preload.js'),
+      contextIsolation: true,
+      nodeIntegration: false,
+      sandbox: false,
